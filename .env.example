# === Control Plane ===
DATABASE_URL="postgresql://user:password@localhost:5432/easyclaw"
NEXTAUTH_SECRET="generate-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (for connector setup)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === AWS ===
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ECS / ECR
ECS_CLUSTER_NAME="clawdbot-cluster"
ECR_REPO_URI=""
VPC_SUBNET_IDS=""
VPC_SECURITY_GROUP_IDS=""

# Shared secret for control-plane <-> runtime auth
CONTROL_PLANE_SHARED_SECRET="generate-a-random-secret"

# Set to "true" to use mock AWS provisioner (for local dev without AWS)
USE_MOCK_PROVISIONER="true"
