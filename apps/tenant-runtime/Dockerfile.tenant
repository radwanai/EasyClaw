# Dockerfile for running clawdbot as a tenant runtime on ECS Fargate.
# Lighter than the main Dockerfile — no Playwright, no cloudflared.
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
# Install production deps + AWS SDK for Secrets Manager
RUN npm install --omit=dev && \
    npm install @aws-sdk/client-secrets-manager

COPY *.js .
COPY dashboard.html .

RUN mkdir -p /app/data /app/skills
COPY skills/ /app/skills/

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

# In tenant mode, we run just the dashboard server (HTTP API)
# The control plane will call endpoints on this.
CMD ["node", "index.js"]
