# Database
DATABASE_URL="postgresql://user:password@localhost:5432/easyclaw"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (for user login + connector)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS credentials (or use IAM role if on EC2/ECS)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ECS configuration (from terraform output)
ECS_CLUSTER_NAME="clawdbot-cluster"
ECR_REPO_URI=""
ECS_TASK_EXECUTION_ROLE_ARN=""
ECS_TASK_ROLE_ARN=""
ECS_LOG_GROUP="/ecs/clawdbot/tenant-runtime"
VPC_SUBNET_IDS=""
VPC_SECURITY_GROUP_IDS=""

# Shared secret for control-plane <-> runtime auth
CONTROL_PLANE_SHARED_SECRET=""

# Local dev: set to "true" to use mock AWS (no real AWS needed)
USE_MOCK_PROVISIONER="true"

# Optional: public AWS region for log links in UI
NEXT_PUBLIC_AWS_REGION="us-east-1"
